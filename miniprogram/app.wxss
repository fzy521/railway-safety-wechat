/* 全局样式 */
page {
  background-color: #f8f9fa;
  color: #333;
  font-family: -apple-system-font, Helvetica Neue, Helvetica, sans-serif;
}

.container {
  padding: 20rpx;
}

/* 安全状态样式 */
.status-safe {
  color: #07c160;
}

.status-warning {
  color: #ffbe00;
}

.status-danger {
  color: #ee0a24;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
}

.card-content {
  color: #666;
  font-size: 28rpx;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #1989fa 0%, #1877f2 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.3);
}

.btn-secondary {
  background: #f7f8fa;
  color: #323233;
  border-radius: 50rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 指标卡片 */
.metric-card {
  text-align: center;
  padding: 40rpx 24rpx;
}

.metric-value {
  font-size: 64rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.metric-label {
  font-size: 28rpx;
  color: #999;
}

/* 图表容器 */
.chart-container {
  height: 400rpx;
  margin: 20rpx 0;
}

/* 风险等级标识 */
.risk-level-low {
  background: #07c160;
  color: white;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.risk-level-medium {
  background: #ffbe00;
  color: white;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.risk-level-high {
  background: #ee0a24;
  color: white;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

/* 表格样式 */
.data-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
  align-items: center;
}

.data-cell {
  flex: 1;
  font-size: 28rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: #999;
}

.loading text {
  margin-left: 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 32rpx;
  color: #999;
}

.empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 48rpx;
}