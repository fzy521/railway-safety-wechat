.scan-login {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
  padding-top: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.scan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.scan-frame {
  width: 500rpx;
  height: 500rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.2);
}

.scan-frame::before,
.scan-frame::after {
  content: '';
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #ffffff;
}

.scan-frame::before {
  top: 0;
  left: 0;
  border-right: none;
  border-bottom: none;
  border-top-left-radius: 16rpx;
}

.scan-frame::after {
  bottom: 0;
  right: 0;
  border-left: none;
  border-top: none;
  border-bottom-right-radius: 16rpx;
}

.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #00ff00, transparent);
  animation: scan 2s linear infinite;
}

@keyframes scan {
  0% {
    top: 0;
  }
  100% {
    top: 100%;
  }
}

.scan-tip {
  display: block;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.status {
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10rpx;
}

.status-text {
  font-size: 28rpx;
  color: #ffffff;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-scan,
.btn-cancel {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-scan {
  background: #ffffff;
  color: #667eea;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}