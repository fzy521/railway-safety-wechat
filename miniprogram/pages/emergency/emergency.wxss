@import "../common.wxss";

/* 页面容器 */
.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 标题区域 */
.header {
  text-align: center;
  padding: var(--spacing-xxxl) 0;
  margin-bottom: var(--spacing-xl);
}

.header .title {
  display: block;
  font-size: var(--font-size-xxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.header .subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* 统计卡片 */
.stats-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-xxxl);
}

.stat-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xxl) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.stat-number {
  font-size: var(--font-size-xxxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  text-align: center;
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-xxxl);
  box-shadow: var(--shadow-md);
}

.tab-item {
  flex: 1;
  padding: var(--spacing-lg);
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  transition: all var(--transition-base);
}

.tab-item.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: var(--font-weight-medium);
}

/* 标签页内容 */
.tab-content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

/* 应急预案卡片 */
.plan-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xxl);
  box-shadow: var(--shadow-md);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.plan-id {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
  display: block;
}

.plan-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.plan-status {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.plan-status.active {
  background: var(--color-success-light);
  color: var(--color-success);
}

.plan-status.draft {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.plan-status.archived {
  background: var(--color-info);
  color: #fff;
}

.plan-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.info-item {
  display: flex;
  flex-direction: column;
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.info-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.info-value {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.plan-meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.meta-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.plan-info {
  margin-bottom: var(--spacing-lg);
}

.plan-dates {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.date-info {
  display: flex;
  margin-bottom: var(--spacing-md);
}

.date-info:last-child {
  margin-bottom: 0;
}

.date-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  min-width: 140rpx;
  margin-right: var(--spacing-lg);
}

.date-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.plan-effectiveness {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
}

.effectiveness-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.effectiveness-value {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.plan-actions {
  display: flex;
  gap: var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
}

.action-btn {
  flex: 1;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg-hover);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  transition: all 0.2s ease;
}

.action-btn:active {
  background: var(--color-bg-page);
}

.action-btn.primary {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.action-btn.primary:active {
  background: var(--color-primary-dark);
}

/* 演练记录卡片 */
.drill-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xxl);
  box-shadow: var(--shadow-md);
}

.drill-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.drill-id {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
  display: block;
}

.drill-plan {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.drill-status {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.drill-status.good {
  background: var(--color-success-light);
  color: var(--color-success);
}

.drill-status.qualified {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.drill-status.pending {
  background: var(--color-info);
  color: #fff;
}

.drill-date {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.date-icon {
  font-size: var(--font-size-xl);
  margin-right: var(--spacing-md);
}

.date-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.drill-info {
  margin-bottom: var(--spacing-lg);
}

.drill-issues {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-danger-light);
  border-radius: var(--radius-md);
}

.issues-label {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.issues-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.drill-improvements {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-warning-light);
  border-radius: var(--radius-md);
}

.improvement-label {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.improvement-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.drill-actions {
  display: flex;
  gap: var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
}

/* 应急物资卡片 */
.supply-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xxl);
  box-shadow: var(--shadow-md);
}

.supply-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.supply-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  flex: 1;
  margin-right: var(--spacing-lg);
}

.supply-status {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.supply-status.normal {
  background: var(--color-success-light);
  color: var(--color-success);
}

.supply-status.warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.supply-status.expiring {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.supply-category {
  margin-bottom: var(--spacing-lg);
}

.category-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.category-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.supply-quantity {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.quantity-info,
.minimum-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.quantity-label,
.minimum-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.quantity-value {
  font-size: var(--font-size-xxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-success);
}

.quantity-value.warning {
  color: var(--color-warning);
}

.quantity-value.expiring {
  color: var(--color-danger);
}

.minimum-value {
  font-size: var(--font-size-lg);
  color: var(--color-text-secondary);
}

.supply-location,
.supply-manager {
  margin-bottom: var(--spacing-lg);
}

.location-label,
.manager-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.location-value,
.manager-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.supply-check {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.check-info,
.expiry-info {
  display: flex;
  margin-bottom: var(--spacing-md);
}

.check-info:last-child,
.expiry-info:last-child {
  margin-bottom: 0;
}

.check-label,
.expiry-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  min-width: 140rpx;
  margin-right: var(--spacing-lg);
}

.check-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.expiry-value {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

/* 响应式设计 */
@media screen and (max-width: 375px) {
  .stats-card {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

}

.info-value.status-success {
  color: var(--color-success);
  font-weight: var(--font-weight-medium);
}

.info-value.status-warning {
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

/* 过滤提示 */
.filter-hint {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-info-light);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
}

.filter-text {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-info);
}

.clear-filter-btn {
  background: var(--color-info);
  color: white;
  border: none;
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
}

/* 添加按钮 */
.add-button {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.add-icon {
  font-size: 80rpx;
  color: #fff;
  line-height: 1;
}

/* 弹窗菜单遮罩层 */
.add-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.add-menu-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* 弹窗菜单容器 */
.add-menu {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: var(--spacing-xxl);
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.add-menu-overlay.show .add-menu {
  transform: translateY(0);
}

/* 菜单头部 */
.menu-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xxl);
  padding-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.menu-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-hover);
  border-radius: 50%;
}

.close-icon {
  font-size: 48rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

/* 菜单项列表 */
.menu-items {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

/* 菜单项 */
.menu-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-xl);
  background: var(--color-bg-hover);
  border-radius: var(--radius-lg);
  transition: all 0.2s ease;
}

.menu-item:active {
  background: var(--color-primary-light);
  transform: scale(0.98);
}

.menu-item-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: var(--spacing-lg);
}

.menu-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-item-title {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.menu-item-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.menu-item-arrow {
  font-size: 40rpx;
  color: var(--color-text-tertiary);
  font-weight: 300;
}