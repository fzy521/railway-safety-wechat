<view class="container">
  <view class="header">
    <text class="title">添加应急预案</text>
    <text class="subtitle">上传PDF文档并创建新预案</text>
  </view>
  
  <form bindsubmit="handleSubmit">
    <!-- 预案名称 -->
    <view class="form-group">
      <text class="form-label">预案名称 *</text>
      <input
        class="form-input"
        name="name"
        placeholder="请输入预案名称"
        value="{{formData.name}}"
        bindinput="onInputChange"
        data-field="name"
      />
    </view>
    
    <!-- 预案类型 -->
    <view class="form-group">
      <text class="form-label">预案类型 *</text>
      <picker
        class="form-picker"
        mode="selector"
        range="{{planTypes}}"
        range-key="label"
        value="{{formData.typeIndex}}"
        bindchange="onTypeChange"
      >
        <view class="picker-value">
          {{formData.typeIndex !== '' ? planTypes[formData.typeIndex].label : '请选择预案类型'}}
        </view>
      </picker>
    </view>

    <!-- PDF文件上传 -->
    <view class="form-group">
      <text class="form-label">预案文档 *</text>
      <text class="form-hint">请上传PDF格式的预案文档</text>
      
      <!-- 上传按钮 -->
      <view class="upload-btn" bindtap="choosePdfFile">
        <text class="upload-icon">📄</text>
        <text class="upload-text">{{uploading ? '上传中...' : '点击上传PDF文件'}}</text>
      </view>

      <!-- 已上传文件列表 -->
      <view wx:if="{{uploadedFiles.length > 0}}" class="file-list">
        <view wx:for="{{uploadedFiles}}" wx:key="id" class="file-item">
          <view class="file-icon">
            <text class="icon-text">PDF</text>
          </view>
          <view class="file-info">
            <text class="file-name">{{item.fileName}}</text>
            <text class="file-meta">{{item.fileSize}} · {{item.uploadTime}}</text>
          </view>
          <view class="file-actions">
            <view class="action-btn preview" bindtap="previewPdf" data-url="{{item.fileUrl}}" data-name="{{item.fileName}}">
              <text>预览</text>
            </view>
            <view class="action-btn delete" bindtap="deleteFile" data-id="{{item.id}}" data-cloud-path="{{item.cloudPath}}" data-name="{{item.fileName}}">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 操作按钮 -->
    <view class="button-group">
      <button class="btn-cancel" bindtap="handleCancel">取消</button>
      <button class="btn-submit" formType="submit">保存预案</button>
    </view>
  </form>
</view>
