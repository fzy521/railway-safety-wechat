@import "../../styles/design-system.wxss";

.container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  background: var(--color-primary);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.certificate-list {
  padding: 0 20rpx;
}

.certificate-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s;
}

.certificate-card:active {
  transform: scale(0.98);
}

.certificate-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.certificate-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.certificate-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.certificate-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 8rpx;
}

.certificate-type {
  font-size: 24rpx;
  color: #969799;
}

.certificate-status {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-valid {
  background: #e6f7ff;
  color: #1890ff;
}

.status-expiring {
  background: #fff7e6;
  color: #fa8c16;
}

.status-expired {
  background: #fff1f0;
  color: #f5222d;
}

.certificate-body {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #969799;
}

.info-value {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
}

.info-value.expiring {
  color: #fa8c16;
}

.certificate-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.days-left {
  background: #f5f5f5;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.days-text {
  font-size: 24rpx;
  color: #666;
}

.view-btn {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1890ff;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #969799;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #c8c9cc;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx;
  font-size: 28rpx;
  color: #969799;
}