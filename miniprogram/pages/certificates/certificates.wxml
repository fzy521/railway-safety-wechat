<view class="container">
  <view class="header">
    <text class="title">我的证书</text>
    <text class="subtitle">共 {{certificates.length}} 个证书</text>
  </view>

  <!-- 证书列表 -->
  <view class="certificate-list" wx:if="{{certificates.length > 0}}">
    <view class="certificate-card" wx:for="{{certificates}}" wx:key="id" bindtap="viewCertificate" data-id="{{item.id}}">
      <view class="certificate-header">
        <image class="certificate-icon" src="/images/safety-certificate.png" mode="aspectFit" />
        <view class="certificate-info">
          <text class="certificate-name">{{item.name}}</text>
          <text class="certificate-type">{{item.type}}</text>
        </view>
        <view class="certificate-status status-{{item.status}}">
          {{item.statusText}}
        </view>
      </view>

      <view class="certificate-body">
        <view class="info-row">
          <text class="info-label">发证机构</text>
          <text class="info-value">{{item.issuer}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">证书编号</text>
          <text class="info-value">{{item.number}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">发证日期</text>
          <text class="info-value">{{item.issueDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">有效期至</text>
          <text class="info-value {{item.isExpiring ? 'expiring' : ''}}">{{item.expiryDate}}</text>
        </view>
      </view>

      <view class="certificate-footer">
        <view class="days-left">
          <text class="days-text">剩余 {{item.daysLeft}} 天</text>
        </view>
        <view class="view-btn">
          <text>查看详情</text>
          <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{certificates.length === 0 && !loading}}">
    <image class="empty-icon" src="/images/icon-certificate.png" mode="aspectFit" />
    <text class="empty-text">暂无证书</text>
    <text class="empty-hint">完成培训后可获得证书</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>