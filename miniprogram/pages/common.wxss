/* 通用样式 - 适用于所有GBT 33000-2025合规页面 */
/* 使用设计系统变量 */
@import "../styles/design-system.wxss";

/* 容器基础样式 */
.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
}

/* 标题区域 */
.header {
  padding: var(--spacing-xl) var(--spacing-lg);
  text-align: center;
  margin-bottom: var(--spacing-xl);
}

.header .title {
  display: block;
  font-size: var(--font-size-xxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.header .subtitle {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

/* 统计卡片 */
.stats-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-xxxl);
}

.stat-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xxl) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.stat-number {
  font-size: var(--font-size-xxxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

/* 标签页 */
.tab-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-md);
}

.tab-item {
  flex: 1;
  padding: var(--spacing-lg);
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  transition: all var(--transition-base);
}

.tab-item.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: var(--font-weight-medium);
}

/* 筛选标签 */
.filter-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-xl);
  box-shadow: var(--shadow-md);
  gap: var(--spacing-sm);
}

.filter-item {
  flex: 1;
  padding: var(--spacing-md);
  text-align: center;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  transition: all var(--transition-base);
}

.filter-item.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: var(--font-weight-medium);
}

/* 卡片通用样式 */
.plan-card, .record-card, .certificate-card, .risk-card, .inspection-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xxl);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

/* 卡片头部 */
.plan-header, .record-header, .certificate-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  padding-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border-light);
}

.plan-title, .record-title, .certificate-title {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.plan-id, .record-id, .certificate-id {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.plan-name, .record-name, .certificate-name-text {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

/* 状态标签 */
.plan-status, .record-status, .certificate-status {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

/* 状态颜色 - 计划 */
.plan-status.planned {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.plan-status.in-progress {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.plan-status.completed {
  background: var(--color-success-light);
  color: var(--color-success);
}

/* 状态颜色 - 记录 */
.record-status.passed {
  background: var(--color-success-light);
  color: var(--color-success);
}

.record-status.failed {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* 状态颜色 - 证书 */
.certificate-status.valid {
  background: var(--color-success-light);
  color: var(--color-success);
}

.certificate-status.expired {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.certificate-status.due-soon {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

/* 卡片内容 */
.plan-info, .record-info, .certificate-info {
  margin-bottom: var(--spacing-lg);
}

.info-row {
  display: flex;
  margin-bottom: var(--spacing-md);
  align-items: flex-start;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  min-width: 140rpx;
  margin-right: var(--spacing-lg);
}

.info-value {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.info-value.score {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.info-value.expiry {
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

/* 结果和评价 */
.plan-result, .plan-evaluation, .certificate-dates, .certificate-authority, .certificate-experience {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.plan-evaluation {
  margin-top: var(--spacing-xl);
}

.result-label, .evaluation-label, .date-label, .authority-label, .experience-label, .notes-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.evaluation-label {
  font-size: var(--font-size-xs);
}

.result-value, .evaluation-value, .date-value, .authority-value, .experience-value, .notes-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.evaluation-value {
  font-size: var(--font-size-xs);
  color: var(--color-success);
  font-weight: var(--font-weight-medium);
}

/* 日期信息 */
.certificate-dates {
  display: flex;
  flex-direction: column;
}

.date-item {
  display: flex;
  margin-bottom: var(--spacing-md);
}

.date-item:last-child {
  margin-bottom: 0;
}

.date-label {
  min-width: 120rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  margin-right: var(--spacing-md);
}

.date-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
}

.date-value.review {
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

/* 人员信息 */
.certificate-employee, .certificate-position, .certificate-type {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  padding-bottom: var(--spacing-md);
  border-bottom: 1rpx solid var(--color-border-light);
}

.certificate-employee:last-child, .certificate-type:last-child {
  border-bottom: none;
}

.employee-label, .position-label, .type-label, .name-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  min-width: 120rpx;
  margin-right: var(--spacing-lg);
}

.employee-name, .position-value, .type-value, .name-value {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.employee-dept {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-left: var(--spacing-xs);
}

/* 按钮样式 */
.plan-actions, .record-actions, .certificate-actions {
  display: flex;
  gap: var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
}

.action-btn {
  flex: 1;
  padding: var(--spacing-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  text-align: center;
  transition: all var(--transition-base);
}

.action-btn.primary {
  background: var(--color-primary);
  color: #fff;
}

.action-btn.primary:active {
  background: var(--color-primary-dark);
}

.action-btn.secondary {
  background: var(--color-bg-hover);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border-base);
}

.action-btn.secondary:active {
  background: var(--color-border-base);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
}

.empty-icon {
  font-size: 120rpx;
  color: var(--color-border-base);
  margin-bottom: var(--spacing-lg);
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-xxxl);
}

/* 响应式设计 */
@media screen and (max-width: 375px) {
  .stats-card {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .container {
    padding: var(--spacing-md);
  }
}
