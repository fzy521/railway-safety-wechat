<view class="container">
  <view class="header">
    <text class="title">账号设置</text>
  </view>

  <!-- 个人信息 -->
  <view class="section">
    <view class="section-title">个人信息</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="editProfile">
        <view class="menu-label">编辑资料</view>
        <view class="menu-value">{{userInfo.name || '未设置'}}</view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="changeAvatar">
        <view class="menu-label">更换头像</view>
        <image class="avatar-preview" src="{{userInfo.avatarUrl || '/images/avatar-default.png'}}" mode="aspectFill" />
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 账号安全 -->
  <view class="section">
    <view class="section-title">账号安全</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="changePassword">
        <view class="menu-label">修改密码</view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="bindPhone">
        <view class="menu-label">绑定手机</view>
        <view class="menu-value">{{userInfo.phone || '未绑定'}}</view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="bindEmail">
        <view class="menu-label">绑定邮箱</view>
        <view class="menu-value">{{userInfo.email || '未绑定'}}</view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 通知设置 -->
  <view class="section">
    <view class="section-title">通知设置</view>
    <view class="menu-list">
      <view class="menu-item">
        <view class="menu-label">消息通知</view>
        <switch checked="{{settings.messageNotification}}" bindchange="onNotificationChange" />
      </view>
      <view class="menu-item">
        <view class="menu-label">风险提醒</view>
        <switch checked="{{settings.riskAlert}}" bindchange="onRiskAlertChange" />
      </view>
      <view class="menu-item">
        <view class="menu-label">隐患提醒</view>
        <switch checked="{{settings.dangerAlert}}" bindchange="onDangerAlertChange" />
      </view>
    </view>
  </view>

  <!-- 其他设置 -->
  <view class="section">
    <view class="section-title">其他</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="clearCache">
        <view class="menu-label">清除缓存</view>
        <view class="menu-value">{{cacheSize}}</view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="checkUpdate">
        <view class="menu-label">检查更新</view>
        <view class="menu-value">v1.0.0</view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
    </view>
  </view>
</view>