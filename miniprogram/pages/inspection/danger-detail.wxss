.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20px;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 0;
}

.loading-spinner {
  width: 40px;
  height: 40px;
  border: 4px solid #f3f3f3;
  border-top: 4px solid #007aff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #999;
  font-size: 14px;
}

/* 隐患详情 */
.danger-detail {
  padding: 16px;
}

/* 基本信息 */
.basic-info {
  background-color: #fff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.title-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.danger-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 12px;
  line-height: 1.4;
}

.danger-badges {
  display: flex;
  gap: 8px;
}

.badge {
  padding: 4px 12px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
  color: #fff;
}

.badge.major {
  background-color: #ee0a24;
}

.badge.general {
  background-color: #ff976a;
}

.status-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.status-item {
  display: flex;
  align-items: center;
}

.status-label {
  font-size: 14px;
  color: #666;
  margin-right: 4px;
}

.status-value {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.status-value.identified {
  color: #ff976a;
}

.status-value.treating {
  color: #007aff;
}

.status-value.completed {
  color: #07c160;
}

.status-value.verified {
  color: #36cbcb;
}

.status-value.closed {
  color: #999;
}

/* 详细信息 */
.detail-section {
  background-color: #fff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  padding-bottom: 12px;
  margin-bottom: 12px;
  border-bottom: 1px solid #eee;
}

.info-item {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12px;
  align-items: flex-start;
}

.info-label {
  font-size: 14px;
  color: #666;
  width: 80px;
  flex-shrink: 0;
  margin-right: 12px;
}

.info-value {
  font-size: 14px;
  color: #333;
  flex: 1;
  min-width: 0;
}

.info-value.info-content {
  line-height: 1.5;
  word-break: break-word;
}

/* 关联风险 */
.risk-list {
  margin-top: 12px;
}

.risk-item {
  background-color: #f9f9f9;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 12px;
  border-left: 4px solid #007aff;
  transition: all 0.3s ease;
}

.risk-item:active {
  background-color: #e8e8e8;
}

.risk-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8px;
}

.risk-title {
  font-size: 15px;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 12px;
  line-height: 1.4;
}

.risk-badge {
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
  color: #fff;
}

.risk-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 8px;
}

.risk-value {
  font-size: 13px;
  color: #666;
}

.risk-description {
  font-size: 13px;
  color: #999;
  line-height: 1.5;
}

/* 空状态 */
.empty-list {
  text-align: center;
  padding: 40px 0;
  color: #999;
  font-size: 14px;
}

.loading-more {
  text-align: center;
  padding: 16px 0;
  color: #999;
  font-size: 14px;
}

/* 操作按钮 */
.action-buttons {
  padding: 0 16px 16px;
}

.btn {
  width: 100%;
  height: 48px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 12px;
}

.btn.primary {
  background-color: #007aff;
  color: #fff;
  border: none;
}

.btn.primary:active {
  background-color: #0066cc;
}
