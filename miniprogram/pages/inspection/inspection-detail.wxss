@import "../../styles/design-system.wxss";

.container {
  padding: 30rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.status-badge, .level-badge {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.status-identified {
  background: #fff3e0;
  color: #ff9800;
}

.status-treating {
  background: #e3f2fd;
  color: #2196f3;
}

.status-completed {
  background: #e8f5e9;
  color: #4caf50;
}

.level-general {
  background: #fff3e0;
  color: #ff9800;
}

.level-major {
  background: #ffebee;
  color: #f44336;
}

.detail-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  word-break: break-all;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
  background: white;
  color: #666;
}

.action-btn.primary {
  background: #2196f3;
  color: white;
}

.action-btn.success {
  background: #4caf50;
  color: white;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  color: #999;
  font-size: 30rpx;
}