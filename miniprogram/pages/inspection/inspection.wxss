/* inspection.wxss */
@import "../../styles/design-system.wxss";

.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
  padding-bottom: 100rpx;
}

/* 统计卡片 */
.stats-cards {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-xl);
  gap: var(--spacing-lg);
}

.stat-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xxl) var(--spacing-lg);
  text-align: center;
  box-shadow: var(--shadow-md);
}

.stat-number {
  display: block;
  font-size: var(--font-size-xxxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
  gap: var(--spacing-lg);
}

/* 检查类型选择器 */
.check-type-selector {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
  gap: var(--spacing-lg);
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-md);
  border-radius: var(--radius-md);
  background: var(--color-bg-hover);
  transition: all var(--transition-base);
}

.type-item.active {
  background: var(--color-primary);
}

.type-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: var(--spacing-md);
}

.type-item.active .type-icon {
  filter: brightness(0) invert(1);
}

.type-label {
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.type-item.active .type-label {
  color: white;
}

.type-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.type-item.active .type-desc {
  color: rgba(255, 255, 255, 0.9);
}

.filter-item {
  flex: 1;
  padding: var(--spacing-lg);
  text-align: center;
  border-radius: var(--radius-md);
  background: var(--color-bg-hover);
  font-size: var(--font-size-sm);
  transition: all var(--transition-base);
}

.filter-item.active {
  background: var(--color-primary);
  color: white;
  font-weight: var(--font-weight-medium);
}

/* 巡检列表 */
.inspection-list {
  max-height: calc(100vh - 400rpx);
}

.inspection-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xxl);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

.inspection-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.inspection-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  flex: 1;
}

.priority-tag {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  margin-left: var(--spacing-lg);
}

.priority-tag.priority-high {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.priority-tag.priority-medium {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.priority-tag.priority-low {
  background: var(--color-success-light);
  color: var(--color-success);
}

.inspection-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.inspection-type {
  background: var(--color-primary-light);
  color: var(--color-primary);
  padding: var(--spacing-xs) var(--spacing-md);
  border-radius: var(--radius-sm);
}

.inspection-schedule,
.inspection-inspector,
.inspection-description,
.inspection-findings {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
}

.inspection-description .value,
.inspection-findings .value {
  flex: 1;
  color: var(--color-text-secondary);
}

.label {
  color: var(--color-text-tertiary);
  margin-right: var(--spacing-lg);
  min-width: 120rpx;
}

.value {
  color: var(--color-text-primary);
  flex: 1;
}

.inspection-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
  margin-top: var(--spacing-lg);
}

.inspection-status {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: var(--spacing-md);
}

.status-dot.status-pending {
  background: #ff976a;
}

.status-dot.status-in-progress {
  background: var(--color-primary);
}

.status-dot.status-completed {
  background: var(--color-success);
}

.status-text {
  font-size: var(--font-size-sm);
}

.actions {
  display: flex;
  gap: var(--spacing-lg);
}

.action-btn {
  padding: var(--spacing-lg) var(--spacing-xxl);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  border: none;
  margin: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.start-btn {
  background: var(--color-success);
  color: white;
}

.detail-btn {
  background: var(--color-bg-hover);
  color: var(--color-text-secondary);
}

/* 添加按钮 */
.add-button {
  position: fixed;
  bottom: 100rpx;
  right: var(--spacing-xl);
  width: 112rpx;
  height: 112rpx;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: var(--z-index-fixed);
}

.add-icon {
  color: white;
  font-size: 48rpx;
  font-weight: var(--font-weight-normal);
  line-height: 1;
  margin-top: -6rpx;
}
