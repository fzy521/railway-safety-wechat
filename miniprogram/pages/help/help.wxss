@import "../../styles/design-system.wxss";

.container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  background: var(--color-primary);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.search-section {
  background: white;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 80rpx 0 30rpx;
  background: #f5f5f5;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 60rpx;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  color: #969799;
  padding: 20rpx 30rpx 10rpx;
}

.faq-list {
  background: white;
}

.faq-item {
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.question-text {
  flex: 1;
  font-size: 30rpx;
  color: #323233;
  font-weight: 500;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.3s;
  opacity: 0.3;
}

.arrow-icon.expanded {
  transform: rotate(90deg);
}

.faq-answer {
  padding: 0 30rpx;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.faq-answer.expanded {
  padding: 0 30rpx 30rpx;
  max-height: 500rpx;
}

.faq-answer text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.guide-list {
  background: white;
}

.guide-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.guide-item:last-child {
  border-bottom: none;
}

.guide-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  padding: 16rpx;
}

.guide-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.guide-title {
  font-size: 30rpx;
  color: #323233;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.guide-desc {
  font-size: 24rpx;
  color: #969799;
}

.contact-section {
  padding: 40rpx 30rpx;
}

.contact-btn {
  width: 100%;
  height: 90rpx;
  background: var(--color-primary);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
}

.contact-btn::after {
  border: none;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.contact-btn text {
  font-size: 30rpx;
  color: white;
  font-weight: bold;
}