<view class="container">
  <view class="header">
    <text class="title">使用帮助</text>
  </view>

  <!-- 搜索框 -->
  <view class="search-section">
    <input class="search-input" placeholder="搜索问题..." bindinput="onSearchInput" />
    <image class="search-icon" src="/images/search.png" mode="aspectFit" />
  </view>

  <!-- 常见问题 -->
  <view class="section">
    <view class="section-title">常见问题</view>
    <view class="faq-list">
      <view class="faq-item" wx:for="{{filteredFaqs}}" wx:key="id" bindtap="toggleFaq" data-id="{{item.id}}">
        <view class="faq-question">
          <text class="question-text">{{item.question}}</text>
          <image class="arrow-icon {{item.expanded ? 'expanded' : ''}}" src="/images/exchange-fill.png" mode="aspectFit" />
        </view>
        <view class="faq-answer {{item.expanded ? 'expanded' : ''}}">
          <text>{{item.answer}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作指南 -->
  <view class="section">
    <view class="section-title">操作指南</view>
    <view class="guide-list">
      <view class="guide-item" wx:for="{{guides}}" wx:key="id" bindtap="viewGuide" data-id="{{item.id}}">
        <image class="guide-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="guide-info">
          <text class="guide-title">{{item.title}}</text>
          <text class="guide-desc">{{item.desc}}</text>
        </view>
        <image class="arrow-icon" src="/images/exchange-fill.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 联系客服 -->
  <view class="contact-section">
    <button class="contact-btn" bindtap="contactService">
      <image class="contact-icon" src="/images/headset-fill.png" mode="aspectFit" />
      <text>联系客服</text>
    </button>
  </view>
</view>