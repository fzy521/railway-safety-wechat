@import "../../styles/design-system.wxss";

.container {
  background: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  background: var(--color-primary);
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.info-card {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin: 0 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 26rpx;
  color: #969799;
  margin-bottom: 32rpx;
}

.update-btn {
  padding: 16rpx 48rpx;
  background: var(--color-primary);
  border-radius: 8rpx;
}

.update-btn text {
  font-size: 28rpx;
  color: white;
  font-weight: 500;
}

.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 26rpx;
  color: #969799;
  padding: 20rpx 30rpx 10rpx;
}

.feature-list {
  background: white;
  padding: 20rpx 0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  font-size: 30rpx;
  color: #323233;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #969799;
  text-align: center;
}

.info-list {
  background: white;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
}

.legal-list {
  background: white;
}

.legal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.legal-item:last-child {
  border-bottom: none;
}

.legal-item text {
  font-size: 30rpx;
  color: #323233;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}

.footer {
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.copyright {
  font-size: 24rpx;
  color: #c8c9cc;
  margin-bottom: 8rpx;
}