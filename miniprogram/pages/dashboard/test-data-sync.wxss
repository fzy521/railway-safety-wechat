.test-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.actions button {
  flex: 1;
}

.results-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.result-count {
  font-size: 24rpx;
  color: #999999;
}

.results-list {
  max-height: 800rpx;
  overflow-y: auto;
}

.result-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  border-left: 6rpx solid #cccccc;
}

.result-item.success {
  background-color: #f0fdf4;
  border-left-color: #22c55e;
}

.result-item.fail {
  background-color: #fef2f2;
  border-left-color: #ef4444;
}

.result-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}

.result-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.result-message {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
}

.result-time {
  font-size: 22rpx;
  color: #999999;
}

.empty-state {
  text-align: center;
  padding: 80rpx 20rpx;
  color: #999999;
  font-size: 26rpx;
}

.info-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.info-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  padding-left: 20rpx;
}