/* 登录页面样式 */
@import "../../styles/design-system.wxss";

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 80rpx 60rpx 60rpx;
}

/* 头部 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 80rpx;
  animation: fadeInDown 0.8s ease-out;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 20rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 20rpx;
  text-shadow: 0 4rpx 8px rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 登录表单 */
.login-form {
  margin-bottom: 60rpx;
  animation: fadeInUp 0.8s ease-out 0.2s forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.wechat-login-btn {
  background: #fff;
  border-radius: 50rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

.form-footer {
  margin-top: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.footer-link {
  font-size: 24rpx;
  color: #fff;
  text-decoration: underline;
}

/* 登录须知 */
.login-notice {
  background: rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  backdrop-filter: blur(10rpx);
  animation: fadeInUp 0.8s ease-out 0.4s forwards;
  opacity: 0;
}

.notice-title {
  display: block;
  font-size: var(--font-size-lg);
  color: #fff;
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--spacing-xl);
  text-align: center;
}

.notice-content {
  display: flex;
  flex-direction: column;
}

.notice-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  position: relative;
}

.notice-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
}

.notice-item:last-child {
  margin-bottom: 0;
}