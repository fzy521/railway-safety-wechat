<view class="container">
  <!-- 统计卡片 -->
  <view class="statistics-section">
    <view class="stat-card stat-total">
      <text class="stat-value">{{statistics.total}}</text>
      <text class="stat-label">全部风险</text>
    </view>
    <view class="stat-card stat-pending">
      <text class="stat-value">{{statistics.pendingAssess}}</text>
      <text class="stat-label">待评估</text>
    </view>
    <view class="stat-card stat-control">
      <text class="stat-value">{{statistics.pendingControl}}</text>
      <text class="stat-label">待管控</text>
    </view>
    <view class="stat-card stat-active">
      <text class="stat-value">{{statistics.controlling}}</text>
      <text class="stat-label">管控中</text>
    </view>
  </view>

  <!-- 状态Tab -->
  <view class="tab-section">
    <view 
      class="tab-item {{activeTab === item.value ? 'active' : ''}}" 
      wx:for="{{statusTabs}}" 
      wx:key="value"
      bindtap="onTabChange"
      data-tab="{{item.value}}">
      <text class="tab-text">{{item.label}}</text>
    </view>
  </view>

  <!-- 风险列表 -->
  <view class="risk-list-section">
    <view class="section-header">
      <text class="section-title">风险清单</text>
      <button class="add-btn" bindtap="addRisk">新增风险</button>
    </view>
    
    <view class="risk-list" wx:if="{{filteredList.length > 0}}">
      <view class="risk-item-card" wx:for="{{filteredList}}" wx:key="id" bindtap="viewRiskDetail" data-id="{{item.id}}">
        <view class="risk-header">
          <text class="risk-name">{{item.name}}</text>
          <view class="risk-level-badge risk-{{item.riskLevel}}">{{item.levelName}}</view>
        </view>
        
        <text class="risk-description">{{item.description}}</text>
        
        <view class="risk-meta">
          <text class="risk-assessment">风险值: {{item.rValue}}</text>
          <text class="risk-responder">责任人: {{item.responder}}</text>
        </view>
        
        <view class="risk-footer">
          <view class="risk-status">
            <view class="status-dot status-{{item.statusClass}}"></view>
            <text class="status-text">{{item.statusText}}</text>
          </view>
          <text class="risk-date">{{item.date}}</text>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无风险数据</text>
    </view>
  </view>
</view>