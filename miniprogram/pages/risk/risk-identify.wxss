@import "../../styles/design-system.wxss";

.container {
  padding: 30rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
  display: flex;
  align-items: center;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.vertical {
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 0;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.form-item.vertical .label {
  width: 100%;
  margin-bottom: 16rpx;
}

.input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  background: transparent;
}

.picker {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.photo-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 50rpx;
  height: 50rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 40rpx;
  line-height: 50rpx;
  text-align: center;
  border-bottom-left-radius: 8rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.photo-add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.button-section {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}