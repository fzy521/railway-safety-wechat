@import "../common.wxss";

.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.info-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  word-break: break-all;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.form-section .info-title {
  border: none;
  margin-bottom: 20rpx;
}

.mes-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.mes-item:last-child {
  border-bottom: none;
}

.mes-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.mes-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.mes-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.picker-arrow {
  font-size: 40rpx;
  color: #999;
  margin-left: 16rpx;
}

.mes-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  padding-left: 8rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4444;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  min-width: 140rpx;
}

.radio-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  background: #f5f5f5;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.radio-btn.active {
  background: #1989fa;
  border-color: #1989fa;
  color: white;
}

.radio-btn.selected {
  background: #07c160;
  border-color: #07c160;
  color: white;
}

.result-section {
  background: var(--color-primary);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 24rpx;
  text-align: center;
}

.result-card {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.result-value {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.result-grade {
  font-size: 36rpx;
  font-weight: bold;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  background: white;
  color: #667eea;
}

.risk-level-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
}

.risk-level-badge.level-1 {
  background: #ff4444;
}

.risk-level-badge.level-2 {
  background: #ff9800;
}

.risk-level-badge.level-3 {
  background: #ffc107;
}

.risk-level-badge.level-4 {
  background: #4caf50;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  color: #999;
  font-size: 30rpx;
}

.risk-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: white;
}

.risk-red {
  background: #ee0a24;
}

.risk-orange {
  background: #ff976a;
}

.risk-yellow {
  background: #ffbe00;
}

.risk-blue {
  background: #1989fa;
}