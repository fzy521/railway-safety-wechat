@import "../../styles/design-system.wxss";

.container {
  padding: 30rpx;
  background: var(--color-bg-page);
  min-height: 100vh;
}

.info-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.risk-badge {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: white;
}

.risk-red {
  background: #ee0a24;
}

.risk-orange {
  background: #ff976a;
}

.risk-yellow {
  background: #ffbe00;
}

.risk-blue {
  background: #1989fa;
}

.form-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
  display: flex;
  align-items: center;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.vertical {
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 0;
}

.label {
  width: 200rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.label.required::after {
  content: ' *';
  color: #ee0a24;
}

.form-item.vertical .label {
  width: 100%;
  margin-bottom: 16rpx;
}

.input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  background: transparent;
}

.picker {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.button-section {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  color: #999;
  font-size: 30rpx;
}