<view class="container">
  <view class="filter-bar">
    <picker class="filter-picker" mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onFilterChange">
      <view class="filter-btn">
        <text class="filter-text">{{currentFilterLabel}}</text>
        <text class="arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="action-bar">
    <button class="action-btn" bindtap="onAutoTrigger">自动触发预警</button>
  </view>

  <view class="warning-list">
    <view class="empty-state" wx:if="{{!loading && warningList.length === 0}}">
      <text class="empty-text">暂无预警记录</text>
    </view>

    <view class="warning-card" wx:for="{{warningList}}" wx:key="_id" bindtap="onDetailTap" data-id="{{item._id}}">
      <view class="card-header">
        <view class="header-left">
          <view class="warning-level" style="background-color: {{item.levelColor}}20; color: {{item.levelColor}}">
            <text class="level-dot" style="background-color: {{item.levelColor}}"></text>
            <text class="level-text">{{item.warningLevel}}级预警</text>
          </view>
          <text class="warning-date">{{item.createdAt}}</text>
        </view>
        <view class="header-right">
          <text class="status-badge">{{item.status}}</text>
        </view>
      </view>

      <view class="card-body">
        <text class="warning-title">{{item.warningTitle}}</text>
        <text class="warning-content">{{item.warningContent}}</text>
      </view>

      <view class="card-info">
        <view class="info-item">
          <text class="info-label">责任单位</text>
          <text class="info-value">{{item.targetUnit}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">完成时限</text>
          <text class="info-value deadline {{item.isOverdue ? 'overdue' : ''}}">{{item.deadline}}</text>
        </view>
      </view>

      <view class="card-footer" wx:if="{{item.status !== '已验收'}}">
        <text class="remaining-days {{item.isOverdue ? 'overdue' : ''}}">
          {{item.isOverdue ? '已超期' : '剩余' + item.remainingDays + '天'}}
        </text>
      </view>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>