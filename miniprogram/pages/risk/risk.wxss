@import "../../styles/design-system.wxss";

.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
}

.statistics-section {
  display: flex;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  overflow-x: auto;
}

.stat-card {
  flex: 1;
  min-width: 140rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.stat-total {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.stat-pending {
  background: linear-gradient(135deg, #ff976a 0%, #ff6b6b 100%);
}

.stat-control {
  background: linear-gradient(135deg, #ffbe00 0%, #ff8f1f 100%);
}

.stat-active {
  background: linear-gradient(135deg, var(--color-primary) 0%, #00c6fb 100%);
}

.stat-value {
  font-size: var(--font-size-xxxl);
  font-weight: var(--font-weight-semibold);
  color: white;
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.9);
}

.tab-section {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-lg) 0;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
}

.tab-item.active {
  background: var(--color-primary);
}

.tab-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

.tab-item.active .tab-text {
  color: white;
  font-weight: var(--font-weight-medium);
}

.risk-list-section {
  margin-bottom: var(--spacing-lg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.add-btn {
  background: var(--color-primary);
  color: white;
  border: none;
  padding: var(--spacing-lg) var(--spacing-xxl);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
}

.risk-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.risk-item-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xxl);
  box-shadow: var(--shadow-md);
  transition: all var(--transition-base);
}

.risk-item-card:active {
  transform: scale(0.98);
}

.risk-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.risk-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  flex: 1;
  margin-right: var(--spacing-lg);
}

.risk-level-badge {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.risk-level-badge.risk-red {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.risk-level-badge.risk-orange {
  background: #fff0e6;
  color: #ff976a;
}

.risk-level-badge.risk-yellow {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.risk-level-badge.risk-blue {
  background: var(--color-success-light);
  color: var(--color-success);
}

.risk-description {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: var(--line-height-relaxed);
  margin-bottom: var(--spacing-lg);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.risk-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.risk-assessment {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.risk-responder {
  color: var(--color-text-secondary);
}

.risk-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
}

.risk-status {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: var(--spacing-md);
}

.status-dot.status-pending-assess {
  background: #ff976a;
}

.status-dot.status-pending-control {
  background: #ffbe00;
}

.status-dot.status-controlling {
  background: var(--color-primary);
}

.status-dot.status-effective {
  background: var(--color-success);
}

.status-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.risk-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.empty-state {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 120rpx var(--spacing-xl);
  text-align: center;
  box-shadow: var(--shadow-md);
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}