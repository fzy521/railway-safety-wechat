@import "../../styles/design-system.wxss";

.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
}

.statistics-section {
  display: flex;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  overflow-x: auto;
}

.stat-card {
  flex: 1;
  min-width: 140rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

/* 重大风险（红色） */
.stat-major {
  background: var(--color-risk-high);
}

/* 较大风险（橙色） */
.stat-large {
  background: var(--color-risk-medium);
}

/* 一般风险（黄色） */
.stat-general {
  background: var(--color-risk-low);
}

/* 低风险（蓝色） */
.stat-minor {
  background: var(--color-risk-minor);
}

.stat-value {
  font-size: var(--font-size-xxxl);
  font-weight: var(--font-weight-semibold);
  color: white;
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.9);
}

.tab-section {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-lg) 0;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
}

.tab-item.active {
  background: var(--color-primary);
}

.tab-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

.tab-item.active .tab-text {
  color: white;
  font-weight: var(--font-weight-medium);
}

.risk-list-section {
  margin-bottom: var(--spacing-lg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 添加按钮 */
.add-button {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.add-icon {
  font-size: 80rpx;
  color: #fff;
  line-height: 1;
}

.risk-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.risk-item-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xxl);
  box-shadow: var(--shadow-md);
  transition: all var(--transition-base);
}

.risk-item-card:active {
  transform: scale(0.98);
}

.risk-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.risk-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  flex: 1;
  margin-right: var(--spacing-lg);
}

.risk-level-badge {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

/* 重大风险（红色） */
.risk-level-badge.risk-major {
  background: var(--color-risk-high-light);
  color: var(--color-risk-high);
}

/* 较大风险（橙色） */
.risk-level-badge.risk-large {
  background: var(--color-risk-medium-light);
  color: var(--color-risk-medium);
}

/* 一般风险（黄色） */
.risk-level-badge.risk-general {
  background: var(--color-risk-low-light);
  color: var(--color-risk-low);
}

/* 低风险（蓝色） */
.risk-level-badge.risk-minor {
  background: var(--color-risk-minor-light);
  color: var(--color-risk-minor);
}

.risk-description {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: var(--line-height-relaxed);
  margin-bottom: var(--spacing-lg);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.risk-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.risk-assessment {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.risk-responder {
  color: var(--color-text-secondary);
}

.risk-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
}

.risk-status {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: var(--spacing-md);
}

.status-dot.status-pending-assess {
  background: var(--color-risk-medium);
}

.status-dot.status-pending-control {
  background: var(--color-risk-low);
}

.status-dot.status-controlling {
  background: var(--color-primary);
}

.status-dot.status-effective {
  background: var(--color-success);
}

.status-dot.status-identified {
  background: var(--color-text-tertiary);
}

.status-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.risk-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
}

.empty-state {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 120rpx var(--spacing-xl);
  text-align: center;
  box-shadow: var(--shadow-md);
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}