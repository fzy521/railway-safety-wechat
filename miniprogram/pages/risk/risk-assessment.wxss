@import "../common.wxss";

.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.form-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #323233;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #1989fa;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #646566;
  margin-bottom: 16rpx;
}

.required {
  color: #ee0a24;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  box-sizing: border-box;
}

.picker {
  width: 100%;
}

.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
}

.picker-value {
  font-size: 28rpx;
  color: #323233;
}

.value {
  font-size: 28rpx;
  color: #646566;
}

.arrow {
  font-size: 40rpx;
  color: #c8c9cc;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: #969799;
  margin-top: 12rpx;
  padding-left: 10rpx;
}

.result-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.result-section .section-title {
  border-left-color: white;
  color: white;
}

.result-card {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 30rpx;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-row:last-child {
  margin-bottom: 0;
}

.result-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.result-value {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.result-grade {
  font-size: 36rpx;
  font-weight: bold;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}