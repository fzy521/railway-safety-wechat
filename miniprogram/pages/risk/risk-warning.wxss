@import "../common.wxss";

.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.filter-bar {
  margin-bottom: 20rpx;
}

.filter-picker {
  width: 100%;
}

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 30rpx;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.filter-text {
  font-size: 28rpx;
  color: #323233;
}

.arrow {
  font-size: 40rpx;
  color: #c8c9cc;
}

.action-bar {
  margin-bottom: 20rpx;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  background: var(--color-primary);
  color: white;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
}

.warning-list {
  min-height: 400rpx;
}

.empty-state,
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text,
.loading-text {
  font-size: 28rpx;
  color: #969799;
}

.warning-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.warning-level {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.level-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.level-text {
  font-size: 24rpx;
}

.warning-date {
  font-size: 24rpx;
  color: #969799;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: #f8f9fa;
  color: #646566;
}

.card-body {
  margin-bottom: 20rpx;
}

.warning-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #323233;
  margin-bottom: 12rpx;
}

.warning-content {
  display: block;
  font-size: 28rpx;
  color: #646566;
  line-height: 1.6;
}

.card-info {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
}

.info-item {
  flex: 1;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #323233;
}

.info-value.deadline {
  font-weight: 500;
}

.info-value.deadline.overdue {
  color: #ee0a24;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f8f9fa;
}

.remaining-days {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.remaining-days.overdue {
  color: #ee0a24;
}