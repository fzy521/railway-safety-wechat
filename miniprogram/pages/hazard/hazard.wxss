@import "../../styles/design-system.wxss";

.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.stat-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.stat-number {
  font-size: var(--font-size-xxxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  margin-bottom: var(--spacing-sm);
}

.stat-label {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-lg) 0;
  border-radius: var(--radius-md);
  transition: all var(--transition-base);
}

.filter-item.active {
  background: var(--color-primary);
}

.filter-item text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

.filter-item.active text {
  color: #fff;
}

/* 隐患类型选择器 */
.hazard-type-selector {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.type-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
}

.type-item.active {
  background: var(--color-primary);
}

.type-item.active .type-label,
.type-item.active .type-desc {
  color: #fff;
}

.type-item.active .type-icon {
  filter: brightness(0) invert(1);
}

.type-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: var(--spacing-md);
}

.type-label {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--spacing-sm);
}

.type-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* 隐患列表 */
.hazard-list {
  height: calc(100vh - 400rpx);
}

.hazard-item {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-md);
}

.hazard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.hazard-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  flex: 1;
  margin-right: var(--spacing-lg);
}

.priority-tag {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

.priority-1 {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.priority-2 {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.priority-3 {
  background: var(--color-info-light);
  color: var(--color-info);
}

.priority-4 {
  background: var(--color-success-light);
  color: var(--color-success);
}

.hazard-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.hazard-type {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.hazard-zone {
  color: var(--color-text-secondary);
}

.hazard-description,
.hazard-deadline,
.hazard-responsible,
.hazard-rectification {
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: var(--line-height-relaxed);
}

.hazard-description .label,
.hazard-deadline .label,
.hazard-responsible .label,
.hazard-rectification .label {
  color: var(--color-text-tertiary);
  margin-right: var(--spacing-sm);
}

.hazard-description .value,
.hazard-deadline .value,
.hazard-responsible .value,
.hazard-rectification .value {
  color: var(--color-text-primary);
}

.hazard-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
}

.hazard-status {
  display: flex;
  align-items: center;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: var(--spacing-md);
}

.status-identified {
  background: var(--color-warning);
}

.status-treating {
  background: var(--color-primary);
}

.status-completed {
  background: var(--color-success);
}

.status-text {
  color: var(--color-text-secondary);
}

.actions {
  display: flex;
  gap: var(--spacing-md);
}

.action-btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  border: none;
}

.start-btn {
  background: var(--color-primary);
  color: #fff;
}

.detail-btn {
  background: var(--color-bg-hover);
  color: var(--color-text-primary);
}

/* 添加按钮 */
.add-button {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.add-icon {
  font-size: 80rpx;
  color: #fff;
  line-height: 1;
}