<!--package-safety/pages/training/training.wxml-->
<view class="container">
  <!-- 标题区域 -->
  <view class="header">
    <text class="title">培训管理</text>
    <text class="subtitle">GBT 33000-2025 人员培训与能力提升</text>
  </view>

  <!-- 统计概览 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-number">{{statistics.totalPlans}}</text>
      <text class="stat-label">培训计划</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{statistics.completedPlans}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{statistics.totalParticipants}}</text>
      <text class="stat-label">培训人次</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{statistics.qualifiedRate}}%</text>
      <text class="stat-label">合格率</text>
    </view>
  </view>

  <!-- 标签页切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="switchTab">
      <text>培训计划</text>
    </view>
    <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="switchTab">
      <text>培训记录</text>
    </view>
  </view>

  <!-- 培训计划标签页 -->
  <view wx:if="{{activeTab === 'plans'}}" class="tab-content">
    <view wx:for="{{trainingPlans}}" wx:key="id" class="plan-card">
      <view class="plan-header">
        <view class="plan-title">
          <text class="plan-id">{{item.id}}</text>
          <text class="plan-name">{{item.name}}</text>
        </view>
        <view class="plan-status {{item.status}}">
          <text>{{item.statusText}}</text>
        </view>
      </view>

      <view class="plan-info">
        <view class="info-row">
          <text class="info-label">培训类型：</text>
          <text class="info-value">{{item.typeName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">培训对象：</text>
          <text class="info-value">{{item.target}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">计划日期：</text>
          <text class="info-value">{{item.plannedDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">培训时长：</text>
          <text class="info-value">{{item.plannedHours}}小时</text>
        </view>
        <view class="info-row">
          <text class="info-label">培训方式：</text>
          <text class="info-value">{{item.trainingMethod}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">培训目标：</text>
          <text class="info-value">{{item.objectives}}</text>
        </view>
      </view>

      <view wx:if="{{item.passRate}}" class="plan-result">
        <text class="result-label">考核结果：</text>
        <text class="result-value">合格率 {{item.passRate}}%</text>
      </view>

      <view wx:if="{{item.evaluation}}" class="plan-evaluation">
        <text class="evaluation-label">效果评价：</text>
        <text class="evaluation-value">{{item.evaluation}}</text>
      </view>

      <view class="plan-actions">
        <button class="action-btn primary" data-id="{{item.id}}" bindtap="viewPlanDetail">查看详情</button>
      </view>
    </view>
  </view>

  <!-- 培训记录标签页 -->
  <view wx:if="{{activeTab === 'records'}}" class="tab-content">
    <view wx:for="{{trainingRecords}}" wx:key="id" class="record-card">
      <view class="record-header">
        <view class="record-title">
          <text class="record-id">{{item.id}}</text>
          <text class="record-name">{{item.employeeName}}</text>
        </view>
        <view class="record-status {{item.result}}">
          <text>{{item.resultText}}</text>
        </view>
      </view>

      <view class="record-info">
        <view class="info-row">
          <text class="info-label">培训项目：</text>
          <text class="info-value">{{item.planName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">所属部门：</text>
          <text class="info-value">{{item.department}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">岗位：</text>
          <text class="info-value">{{item.position}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">培训日期：</text>
          <text class="info-value">{{item.trainingDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">培训时长：</text>
          <text class="info-value">{{item.hours}}小时</text>
        </view>
        <view class="info-row">
          <text class="info-label">考核成绩：</text>
          <text class="info-value score">{{item.score}}分</text>
        </view>
        <view class="info-row">
          <text class="info-label">证书编号：</text>
          <text class="info-value">{{item.certificateNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">发证日期：</text>
          <text class="info-value">{{item.issueDate}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">到期日期：</text>
          <text class="info-value expiry">{{item.expiryDate}}</text>
        </view>
      </view>

      <view class="record-actions">
        <button class="action-btn secondary" data-id="{{item.id}}" bindtap="viewRecordDetail">查看详情</button>
      </view>
    </view>
  </view>
</view>