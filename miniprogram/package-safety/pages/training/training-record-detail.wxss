.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.record-header {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.result-badge {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.result-passed {
  background: #e8f5e9;
  color: #4caf50;
}

.result-failed {
  background: #ffebee;
  color: #f44336;
}

.detail-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  word-break: break-all;
}

.value.score {
  color: #2196f3;
  font-weight: bold;
  font-size: 32rpx;
}

.action-buttons {
  margin-top: 30rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #2196f3;
  color: white;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  color: #999;
  font-size: 30rpx;
}