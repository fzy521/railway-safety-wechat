/* Design System - 设计规范 */

/* ========== Color System ========== */
:root {
  /* Primary Colors */
  --color-primary: #1989fa;
  --color-primary-light: #e8f4ff;
  --color-primary-dark: #1877f2;

  /* Functional Colors */
  --color-success: #07c160;
  --color-success-light: #e8f8f0;
  --color-warning: #ff8f1f;
  --color-warning-light: #fff8e0;
  --color-danger: #ee0a24;
  --color-danger-light: #ffecec;
  --color-info: #909399;

  /* Neutral Colors */
  --color-text-primary: #323233;
  --color-text-secondary: #646566;
  --color-text-tertiary: #969799;
  --color-text-placeholder: #c8c9cc;

  /* Background Colors */
  --color-bg-page: #f7f8fa;
  --color-bg-card: #ffffff;
  --color-bg-hover: #f2f3f5;

  /* Border Colors */
  --color-border-base: #ebedf0;
  --color-border-light: #f7f8fa;

  /* Shadows */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  --shadow-primary: 0 4rpx 16rpx rgba(25, 137, 250, 0.2);
}

/* ========== Typography System ========== */
:root {
  /* Font Sizes */
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 30rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 40rpx;
  --font-size-xxxl: 48rpx;

  /* Font Weights */
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* Line Heights */
  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.8;
}

/* ========== Spacing System ========== */
:root {
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 20rpx;
  --spacing-xl: 24rpx;
  --spacing-xxl: 32rpx;
  --spacing-xxxl: 40rpx;
}

/* ========== Border Radius System ========== */
:root {
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-xxl: 24rpx;
  --radius-full: 9999rpx;
}

/* ========== Transition System ========== */
:root {
  --transition-fast: 0.2s;
  --transition-base: 0.3s;
  --transition-slow: 0.5s;
  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ========== Z-Index System ========== */
:root {
  --z-index-dropdown: 1000;
  --z-index-sticky: 1020;
  --z-index-fixed: 1030;
  --z-index-modal-backdrop: 1040;
  --z-index-modal: 1050;
  --z-index-popover: 1060;
  --z-index-tooltip: 1070;
}

/* ========== Button System ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) var(--spacing-xxl);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border: none;
  transition: all var(--transition-base);
  line-height: 1.5;
  cursor: pointer;
}

.btn:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  background: var(--color-primary-dark);
}

.btn-secondary {
  background: var(--color-bg-hover);
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border-base);
}

.btn-secondary:active {
  background: var(--color-border-base);
}

.btn-success {
  background: var(--color-success);
  color: #fff;
}

.btn-danger {
  background: var(--color-danger);
  color: #fff;
}

.btn-sm {
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
}

.btn-lg {
  padding: var(--spacing-xl) var(--spacing-xxxl);
  font-size: var(--font-size-lg);
}

.btn-full {
  width: 100%;
}

/* ========== Card System ========== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-md);
  margin-bottom: var(--spacing-lg);
}

.card-sm {
  padding: var(--spacing-lg);
  border-radius: var(--radius-md);
}

.card-lg {
  padding: var(--spacing-xxl);
  border-radius: var(--radius-xl);
}

/* ========== Form System ========== */
.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  font-weight: var(--font-weight-medium);
}

.form-label.required::after {
  content: ' *';
  color: var(--color-danger);
}

.input {
  width: 100%;
  padding: var(--spacing-lg);
  border: 2rpx solid var(--color-border-base);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-card);
  transition: all var(--transition-fast);
}

.input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(25, 137, 250, 0.1);
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: var(--spacing-lg);
  border: 2rpx solid var(--color-border-base);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-card);
  transition: all var(--transition-fast);
}

.textarea:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(25, 137, 250, 0.1);
}

/* ========== List System ========== */
.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-xl);
  background-color: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  transition: background-color var(--transition-fast);
}

.list-item:active {
  background-color: var(--color-bg-hover);
}

.list-item:last-child {
  border-bottom: none;
}

/* ========== Tag System ========== */
.tag {
  display: inline-block;
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-success {
  background: var(--color-success-light);
  color: var(--color-success);
}

.tag-warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.tag-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* ========== Status Dot ========== */
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
}

.status-dot.success { background-color: var(--color-success); }
.status-dot.warning { background-color: var(--color-warning); }
.status-dot.danger { background-color: var(--color-danger); }
.status-dot.info { background-color: var(--color-info); }

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  color: var(--color-text-tertiary);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.3;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
}

/* ========== Loading ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxxl);
  color: var(--color-text-tertiary);
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--color-border-base);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== Container ========== */
.container {
  padding: var(--spacing-lg);
  background-color: var(--color-bg-page);
  min-height: 100vh;
}