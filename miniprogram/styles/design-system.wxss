/* Design System - 铁路安全监控设计规范 */

/* ========== CSS Variables ========== */
page {
  /* ========== Color System ========== */
  /* Primary Colors - 专业蓝色系 */
  --color-primary: #1976d2;
  --color-primary-light: #e3f2fd;
  --color-primary-dark: #0d47a1;

  /* Risk Level Colors - 风险等级颜色 */
  --color-risk-high: #d32f2f;
  --color-risk-high-light: #ffebee;

  --color-risk-medium: #f57c00;
  --color-risk-medium-light: #fff3e0;

  --color-risk-low: #fbc02d;
  --color-risk-low-light: #fffde7;

  --color-risk-minor: #388e3c;
  --color-risk-minor-light: #e8f5e9;

  /* Functional Colors */
  --color-success: #2e7d32;
  --color-success-light: #e8f5e9;

  --color-warning: #f57c00;
  --color-warning-light: #fff3e0;

  --color-danger: #c62828;
  --color-danger-light: #ffebee;

  --color-info: #0277bd;
  --color-info-light: #e1f5fe;

  /* Neutral Colors - 中性色系统 */
  --color-text-primary: #1a1a1a;
  --color-text-secondary: #424242;
  --color-text-tertiary: #757575;
  --color-text-placeholder: #9e9e9e;
  --color-text-hint: #bdbdbd;

  /* Background Colors */
  --color-bg-page: #f5f7fa;
  --color-bg-card: #ffffff;
  --color-bg-elevated: #ffffff;
  --color-bg-hover: #e8eaed;
  --color-bg-active: #dfe1e5;

  /* Border Colors */
  --color-border-base: #e0e0e0;
  --color-border-light: #f0f0f0;
  --color-border-dark: #bdbdbd;

  /* Shadows - 增强层次感 */
  --shadow-xs: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  --shadow-xl: 0 12rpx 32rpx rgba(0, 0, 0, 0.18);

  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.08), 0 0 0 1rpx rgba(0, 0, 0, 0.04);
  --shadow-card-hover: 0 4rpx 20rpx rgba(0, 0, 0, 0.12), 0 0 0 1rpx rgba(0, 0, 0, 0.06);
  --shadow-elevated: 0 4rpx 24rpx rgba(0, 0, 0, 0.12), 0 0 0 1rpx rgba(0, 0, 0, 0.08);

  --shadow-primary: 0 4rpx 16rpx rgba(25, 118, 210, 0.3);
  --shadow-success: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
  --shadow-warning: 0 4rpx 16rpx rgba(245, 124, 0, 0.3);
  --shadow-danger: 0 4rpx 16rpx rgba(198, 40, 40, 0.3);
  --shadow-info: 0 4rpx 16rpx rgba(2, 119, 189, 0.3);

  /* Surface Colors */
  --color-surface-1: #ffffff;
  --color-surface-2: #fafafa;
  --color-surface-3: #f5f5f5;
  --color-surface-4: #eeeeee;

  /* ========== Typography System ========== */
  /* Font Sizes */
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 30rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 40rpx;
  --font-size-xxxl: 48rpx;
  --font-size-display: 56rpx;

  /* Font Weights */
  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* Line Heights */
  --line-height-tight: 1.2;
  --line-height-normal: 1.5;
  --line-height-relaxed: 1.8;
  --line-height-loose: 2.0;

  /* Letter Spacing */
  --letter-spacing-tight: -0.02em;
  --letter-spacing-normal: 0;
  --letter-spacing-wide: 0.02em;

  /* ========== Spacing System ========== */
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 20rpx;
  --spacing-xl: 24rpx;
  --spacing-xxl: 32rpx;
  --spacing-xxxl: 40rpx;
  --spacing-section: 48rpx;
  --spacing-container: 64rpx;

  /* ========== Border Radius System ========== */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 20rpx;
  --radius-xxl: 24rpx;
  --radius-pill: 9999rpx;
  --radius-circle: 50%;

  /* ========== Z-Index System ========== */
  --z-index-dropdown: 1000;
  --z-index-sticky: 1020;
  --z-index-fixed: 1030;
  --z-index-modal-backdrop: 1040;
  --z-index-modal: 1050;
  --z-index-popover: 1060;
  --z-index-tooltip: 1070;
  --z-index-toast: 1080;

  /* ========== Transitions ========== */
  --transition-fast: 0.15s ease-out;
  --transition-base: 0.25s ease-out;
  --transition-slow: 0.35s ease-out;
  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

/* ========== Button System ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg) var(--spacing-xxl);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border: none;
  transition: all var(--transition-base) var(--ease-default);
  line-height: 1.5;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0);
  transition: background var(--transition-fast);
}

.btn:active::before {
  background: rgba(255, 255, 255, 0.1);
}

.btn:active {
  transform: scale(0.98);
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  box-shadow: var(--shadow-md);
}

.btn-secondary {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border-base);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:active {
  background: var(--color-bg-hover);
  box-shadow: var(--shadow-xs);
}

.btn-success {
  background: var(--color-success);
  color: #fff;
  box-shadow: var(--shadow-success);
}

.btn-warning {
  background: var(--color-warning);
  color: #fff;
  box-shadow: var(--shadow-warning);
}

.btn-danger {
  background: var(--color-danger);
  color: #fff;
  box-shadow: var(--shadow-danger);
}

.btn-info {
  background: var(--color-info);
  color: #fff;
  box-shadow: var(--shadow-info);
}

.btn-sm {
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-sm);
}

.btn-lg {
  padding: var(--spacing-xl) var(--spacing-xxxl);
  font-size: var(--font-size-lg);
  border-radius: var(--radius-lg);
}

.btn-xl {
  padding: var(--spacing-xxl) var(--spacing-container);
  font-size: var(--font-size-xl);
  border-radius: var(--radius-xl);
}

.btn-full {
  width: 100%;
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  box-shadow: none;
}

.btn-ghost:active {
  background: var(--color-primary-light);
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  box-shadow: none;
}

.btn-outline:active {
  background: var(--color-primary-light);
}

/* ========== Card System ========== */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xxl);
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border-light);
  transition: all var(--transition-base) var(--ease-default);
  position: relative;
}

.card:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-2rpx);
}

.card-sm {
  padding: var(--spacing-lg);
  border-radius: var(--radius-md);
}

.card-lg {
  padding: var(--spacing-xxxl);
  border-radius: var(--radius-xl);
}

.card-xl {
  padding: var(--spacing-container);
  border-radius: var(--radius-xxl);
}

.card-elevated {
  box-shadow: var(--shadow-elevated);
  border: none;
}

.card-bordered {
  border: 2rpx solid var(--color-border-base);
  box-shadow: none;
}

.card-no-padding {
  padding: 0;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-xl);
  padding-bottom: var(--spacing-lg);
  border-bottom: 2rpx solid var(--color-border-light);
}

.card-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.card-body {
  margin-bottom: var(--spacing-xl);
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-border-light);
  gap: var(--spacing-md);
}

/* ========== Form System ========== */
.form-item {
  margin-bottom: var(--spacing-xl);
}

.form-label {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-normal);
}

.form-label.required::after {
  content: ' *';
  color: var(--color-danger);
  margin-left: 2rpx;
}

.form-hint {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-xs);
  line-height: var(--line-height-normal);
}

.form-error {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  margin-top: var(--spacing-xs);
  line-height: var(--line-height-normal);
}

.input {
  width: 100%;
  padding: var(--spacing-lg);
  border: 2rpx solid var(--color-border-base);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-card);
  color: var(--color-text-primary);
  transition: all var(--transition-fast) var(--ease-default);
  line-height: 1.5;
}

.input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(25, 118, 210, 0.1);
  outline: none;
}

.input::placeholder {
  color: var(--color-text-hint);
}

.input-disabled {
  background-color: var(--color-bg-hover);
  color: var(--color-text-tertiary);
  cursor: not-allowed;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: var(--spacing-lg);
  border: 2rpx solid var(--color-border-base);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-card);
  color: var(--color-text-primary);
  transition: all var(--transition-fast) var(--ease-default);
  line-height: var(--line-height-normal);
  resize: vertical;
}

.textarea:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(25, 118, 210, 0.1);
  outline: none;
}

.picker {
  width: 100%;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--spacing-lg);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border-base);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  transition: all var(--transition-fast) var(--ease-default);
}

.picker-value.active {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(25, 118, 210, 0.1);
}

.picker-placeholder {
  color: var(--color-text-hint);
}

/* ========== List System ========== */
.list {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border-light);
}

.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-xl);
  border-bottom: 1rpx solid var(--color-border-light);
  transition: background-color var(--transition-fast) var(--ease-default);
  position: relative;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background-color: var(--color-bg-hover);
}

.list-item-pressed {
  background-color: var(--color-bg-active);
}

.list-item-clickable {
  cursor: pointer;
}

.list-item-divider {
  padding: 0;
  height: 1rpx;
  background-color: var(--color-border-light);
  margin: var(--spacing-sm) 0;
}

.list-item-header {
  background-color: var(--color-surface-2);
  padding: var(--spacing-lg) var(--spacing-xl);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: var(--letter-spacing-wide);
}

/* ========== Tag System ========== */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  line-height: 1.5;
  white-space: nowrap;
}

.tag-sm {
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: 20rpx;
  border-radius: var(--radius-sm);
}

.tag-lg {
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-size-base);
  border-radius: var(--radius-lg);
}

.tag-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-success {
  background: var(--color-success-light);
  color: var(--color-success);
}

.tag-warning {
  background: var(--color-warning-light);
  color: var(--color-warning);
}

.tag-danger {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

.tag-info {
  background: var(--color-info-light);
  color: var(--color-info);
}

.tag-outline {
  background: transparent;
  border: 1rpx solid currentColor;
}

/* ========== Badge System ========== */
.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-danger);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-bg-card);
  line-height: 1;
  box-shadow: var(--shadow-sm);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  min-width: auto;
  padding: 0;
  border-radius: var(--radius-circle);
}

/* ========== Status Dot ========== */
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-circle);
  display: inline-block;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.1);
}

.status-dot.success { 
  background-color: var(--color-success); 
  box-shadow: 0 0 0 2rpx rgba(46, 125, 50, 0.2);
}

.status-dot.warning { 
  background-color: var(--color-warning); 
  box-shadow: 0 0 0 2rpx rgba(245, 124, 0, 0.2);
}

.status-dot.danger { 
  background-color: var(--color-danger); 
  box-shadow: 0 0 0 2rpx rgba(198, 40, 40, 0.2);
}

.status-dot.info { 
  background-color: var(--color-info); 
  box-shadow: 0 0 0 2rpx rgba(2, 119, 189, 0.2);
}

.status-dot.high { 
  background-color: var(--color-risk-high); 
  box-shadow: 0 0 0 2rpx rgba(211, 47, 47, 0.2);
}

.status-dot.medium { 
  background-color: var(--color-risk-medium); 
  box-shadow: 0 0 0 2rpx rgba(245, 124, 0, 0.2);
}

.status-dot.low { 
  background-color: var(--color-risk-low); 
  box-shadow: 0 0 0 2rpx rgba(251, 192, 45, 0.2);
}

.status-dot.minor { 
  background-color: var(--color-risk-minor); 
  box-shadow: 0 0 0 2rpx rgba(56, 142, 60, 0.2);
}

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-xl);
  color: var(--color-text-tertiary);
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--spacing-xl);
  opacity: 0.3;
}

.empty-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-normal);
}

.empty-description {
  font-size: var(--font-size-sm);
  color: var(--color-text-hint);
  margin-top: var(--spacing-sm);
  line-height: var(--line-height-normal);
}

/* ========== Loading State ========== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxxl);
  color: var(--color-text-tertiary);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--color-border-base);
  border-top-color: var(--color-primary);
  border-radius: var(--radius-circle);
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-lg);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== Divider ========== */
.divider {
  height: 1rpx;
  background-color: var(--color-border-base);
  margin: var(--spacing-lg) 0;
}

.divider-vertical {
  width: 1rpx;
  height: 100%;
  background-color: var(--color-border-base);
  margin: 0 var(--spacing-lg);
}

.divider-text {
  display: flex;
  align-items: center;
  text-align: center;
  color: var(--color-text-tertiary);
  margin: var(--spacing-xl) 0;
}

.divider-text::before,
.divider-text::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background-color: var(--color-border-base);
}

.divider-text::before {
  margin-right: var(--spacing-lg);
}

.divider-text::after {
  margin-left: var(--spacing-lg);
}

/* ========== Avatar ========== */
.avatar {
  border-radius: var(--radius-circle);
  object-fit: cover;
  display: block;
}

.avatar-xs { 
  width: 48rpx; 
  height: 48rpx; 
}

.avatar-sm { 
  width: 64rpx; 
  height: 64rpx; 
}

.avatar-md { 
  width: 80rpx; 
  height: 80rpx; 
}

.avatar-lg { 
  width: 96rpx; 
  height: 96rpx; 
}

.avatar-xl { 
  width: 120rpx; 
  height: 120rpx; 
}

.avatar-xxl { 
  width: 160rpx; 
  height: 160rpx; 
}

/* ========== Progress ========== */
.progress {
  width: 100%;
  height: 8rpx;
  background-color: var(--color-surface-4);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-pill);
  transition: width var(--transition-base) var(--ease-default);
}

.progress-bar.success {
  background: var(--color-success);
}

.progress-bar.warning {
  background: var(--color-warning);
}

.progress-bar.danger {
  background: var(--color-danger);
}

/* ========== Switch ========== */
.switch {
  width: 88rpx;
  height: 48rpx;
  background-color: var(--color-border-dark);
  border-radius: var(--radius-pill);
  position: relative;
  transition: background-color var(--transition-base) var(--ease-default);
  cursor: pointer;
}

.switch.active {
  background-color: var(--color-primary);
}

.switch-handle {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #fff;
  border-radius: var(--radius-circle);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-base) var(--ease-default);
}

.switch.active .switch-handle {
  transform: translateX(40rpx);
}

/* ========== Risk Level Styles ========== */
.risk-badge {
  display: inline-flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: var(--radius-pill);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  line-height: 1.5;
}

.risk-badge.high {
  background: var(--color-risk-high-light);
  color: var(--color-risk-high);
  box-shadow: 0 2rpx 8rpx rgba(211, 47, 47, 0.15);
}

.risk-badge.medium {
  background: var(--color-risk-medium-light);
  color: var(--color-risk-medium);
  box-shadow: 0 2rpx 8rpx rgba(245, 124, 0, 0.15);
}

.risk-badge.low {
  background: var(--color-risk-low-light);
  color: var(--color-risk-low);
  box-shadow: 0 2rpx 8rpx rgba(251, 192, 45, 0.15);
}

.risk-badge.minor {
