{
  "pages": [
    "pages/index/index",
    "pages/login/login",
    "pages/dashboard/dashboard",
    "pages/risk/risk",
    "pages/incident/incident",
    "pages/inspection/inspection",
    "pages/profile/profile"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "铁路安全监控",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#f8f9fa"
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#1989fa",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/dashboard/dashboard",
        "iconPath": "images/icon-dashboard.png",
        "selectedIconPath": "images/icon-dashboard-active.png",
        "text": "监控"
      },
      {
        "pagePath": "pages/risk/risk",
        "iconPath": "images/icon-risk.png",
        "selectedIconPath": "images/icon-risk-active.png",
        "text": "风险"
      },
      {
        "pagePath": "pages/incident/incident",
        "iconPath": "images/icon-incident.png",
        "selectedIconPath": "images/icon-incident-active.png",
        "text": "事故"
      },
      {
        "pagePath": "pages/inspection/inspection",
        "iconPath": "images/icon-inspection.png",
        "selectedIconPath": "images/icon-inspection-active.png",
        "text": "巡检"
      },
      {
        "pagePath": "pages/profile/profile",
        "iconPath": "images/icon-profile.png",
        "selectedIconPath": "images/icon-profile-active.png",
        "text": "我的"
      }
    ]
  },
  "subPackages": [
    {
      "root": "package-safety",
      "pages": [
        "pages/training/training",
        "pages/certificate/certificate",
        "pages/report/report"
      ]
    }
  ],
  "cloud": true,
  "permission": {
    "scope.userLocation": {
      "desc": "需要获取您的位置信息用于定位巡检点"
    }
  },
  "requiredBackgroundModes": [
    "audio",
    "location"
  ],
  "lazyCodeLoading": "requiredComponents"
}