# 忽略操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 忽略IDE配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# 忽略日志文件
*.log
*.log.*
logs/

# 忽略临时文件
*.tmp
*.temp
.cache/
temp/

# 忽略环境变量文件（如果有的话）
.env
.env.local
.env.*.local

# 忽略node_modules（如果将来添加的话）
node_modules/

# 忽略构建输出
/dist/
/build/
/output/

# 忽略编辑器备份文件
*.bak
*.backup
